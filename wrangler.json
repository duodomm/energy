{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "altenergo-rf",
  "compatibility_date": "2025-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "altenergo-leads",
      "database_id": "ЗАМЕНИ_НА_ID_ПОСЛЕ_d1_create"
    }
  ],
  "vars": {
    "CRM_WEBHOOK_URL": ""
  },
  "limits": {
    "cpu_ms": 50
  }
}
